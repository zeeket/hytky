# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.mjs"
# should be updated accordingly.

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL=postgres://postgres:examplechangeme@postgres:5432/postgres
POSTGRES_PASSWORD=examplechangeme

# Next Auth
# You can generate a new secret on the command line with:
# openssl rand -base64 32
# https://next-auth.js.org/configuration/options#secret
# NEXTAUTH_SECRET=""
# Must be an HTTPS URL registered in @BotFather's Web Login allowed URLs:
# Telegram's OIDC provider rejects `localhost` and bare IP redirect URIs.
# For local development see "Local HTTPS" in the README.
NEXTAUTH_URL=https://local.hytky.org

# Next Auth Telegram OpenID Connect provider, from @BotFather under
# Bot Settings > Web Login (the Client ID is the bot's ID)
TG_OAUTH_CLIENT_ID=
TG_OAUTH_CLIENT_SECRET=

# HYTKYbot Service URL
# Default: http://hytkybot:3000 (for Docker Compose)
# CI should set this to http://localhost:3001
# HYTKYBOT_URL=http://hytkybot:3000

# Name for the root category of the forum
# This is used to create the root category during seeding
FORUM_ROOT_NAME=HYTKY Foorumi

# Link to the telegram info channel
NEXT_PUBLIC_TG_INFO_CHANNEL=https://google.com

# Google Calendar ID (optional, used by events router)
# Example: your-calendar-id@group.calendar.google.com
# GOOGLE_CALENDAR_ID=

# Internal API Secret
# Used to authenticate requests from internal services (like gcalservice)
# Generate with: make generate-internal-api-secret
# Must match INTERNAL_API_SECRET in .gcalservice.env
INTERNAL_API_SECRET=

# Playwright Tests
# Base URL for Playwright e2e tests
# Leave unset to let tests/scripts/dev-url.sh detect it (local HTTPS certs >
# http://localhost). CI should set this to http://localhost:3000
# PLAYWRIGHT_BASE_URL=https://local.hytky.org